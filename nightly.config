/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    UNTRACKED override config (do NOT commit) — OpenMS 3.6.0 nightly containers
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The .idparquet/.featureparquet/.consensusparquet formats only exist in OpenMS
    3.6.0 dev (nightly). Released BioContainers (3.5.0) pinned in each module lack
    them. This overrides every process tagged `openms` / `openms_thirdparty` to the
    ghcr.io nightly images in one place, instead of editing 20 module containers.

    Usage:
        nextflow run main.nf -profile test_full,docker -c nightly.config --outdir results

    Selectors are end-anchored because 'openms' is a prefix of 'openms_thirdparty';
    an unanchored regex would put the thirdparty-less image on Comet/Percolator.
----------------------------------------------------------------------------------------
*/

process {
    // Safety cap for running the full-size test on a single shared host.
    resourceLimits = [ cpus: 24, memory: 220.GB, time: 24.h ]

    withLabel: '^openms$' {
        container = 'ghcr.io/openms/openms-executables:latest'
    }
    withLabel: '^openms_thirdparty$' {
        container = 'ghcr.io/openms/openms-tools-thirdparty:latest'
    }
}
